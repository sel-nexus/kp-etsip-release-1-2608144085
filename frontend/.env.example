# Same-origin business prefix; never put Mongo or secrets in browser config.
VITE_API_BASE_URL=/api
# Development-only backend proxy target.
API_PROXY_TARGET=http://127.0.0.1:8000
FRONTEND_PORT=5173
# Test runner entry origins and disposable fixture database.
E2E_BASE_URL=http://127.0.0.1:5173
E2E_API_URL=http://127.0.0.1:8000
E2E_MONGODB_URI=mongodb://127.0.0.1:27017
E2E_MONGODB_DB=etsip_e2e_auth
