# External Mongo endpoint; select database separately.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=kp_etsip
# Dummy documentation value: replace with a generated signing key.
JWT_SECRET=dummy-change-in-production-signing-key
JWT_ISSUER=kp-etsip
JWT_EXPIRY_HOURS=8
# Explicit development browser origins.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000
