# External Mongo endpoint; select database separately.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=kp_etsip
# Required: supply a generated signing key through secure runtime configuration.
JWT_SECRET=
JWT_ISSUER=kp-etsip
JWT_EXPIRY_HOURS=8
# Explicit development browser origins.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000

# Optional startup demonstration; explicit CLI: python -m api.seed.runner
SEED_ON_STARTUP=false
# Rejected samples: supply credentials through secure operator environment.
SEED_ADMIN_PASSWORD=dummy-replace-me
SEED_DEMO_PASSWORD=dummy-replace-me
